FROM docker.io/library/debian:13-slim

RUN useradd --create-home --uid 1000 worker
COPY --chmod=0555 worker/entry.py /opt/gravityclaw/entry.py
COPY --chmod=0555 .tools/antigravity /usr/local/libexec/agy
COPY --chmod=0555 worker/agy-wrapper.sh /usr/local/bin/agy
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       python3 ca-certificates dbus gnome-keyring \
    && rm -rf /var/lib/apt/lists/*
USER worker
WORKDIR /workspace
ENTRYPOINT ["python3", "/opt/gravityclaw/entry.py", "--"]
