# GravityClaw Environment Configuration
# Copy this to .env and fill in your values

# Server port (default: 8787)
GRAVITYCLAW_PORT=8787

# Execution mode: "agy" (real) or "fake" (testing)
GRAVITYCLAW_MODE=agy

# Execution target: "host" (subprocess) or "container" (podman)
GRAVITYCLAW_EXECUTION_TARGET=host

# Worker image for container execution mode
GRAVITYCLAW_WORKER_IMAGE=localhost/gravityclaw-agy:1.1.13

# Path to your authenticated AGY binary
AGY_BINARY_PATH=./.tools/antigravity

# AGY config directory (contains auth credentials)
AGY_CONFIG_DIR=~/.config/agy

# Telegram integration (optional)
GRAVITYCLAW_TELEGRAM_USER_ID=
GRAVITYCLAW_TELEGRAM_DEFAULT_WORKSPACE=

# Enable learning subsystem
GRAVITYCLAW_LEARNING_ENABLED=true

# Cookie security (set to 1 for HTTPS deployments)
GRAVITYCLAW_COOKIE_SECURE=1

# Secret file paths (create these files with your tokens)
CONTROL_TOKEN_FILE=./secrets/control-token
TELEGRAM_TOKEN_FILE=./secrets/telegram-token

# Podman socket (for container execution)
PODMAN_SOCKET=/run/user/1000/podman/podman.sock

# Domain for Caddy reverse proxy (used with --profile with-proxy)
GRAVITYCLAW_DOMAIN=gravityclaw.example.com
